#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
wallpaper_dir="$HOME/Pictures/Noctalia/Wallpapers"

# Keep this safe and portable: avoid hardcoded paths, monitor names, and app IDs.
# We only copy the config and set a clean wallpaper path.

if ! command -v git >/dev/null 2>&1; then
  echo "[1/4] Installing git..."
  sudo pacman -S --needed --noconfirm git
fi

if ! command -v meson >/dev/null 2>&1 || ! command -v ninja >/dev/null 2>&1; then
  echo "[1/4] Installing build dependencies for Noctalia..."
  sudo pacman -S --needed --noconfirm base-devel meson ninja cmake git wayland-protocols pkgconf
fi

if ! command -v noctalia >/dev/null 2>&1; then
  echo "[2/4] Building and installing Noctalia from upstream..."
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT
  git clone --depth 1 https://github.com/noctalia-dev/noctalia.git "$tmpdir/noctalia"
  cd "$tmpdir/noctalia"
  meson setup build --prefix=/usr
  ninja -C build
  sudo ninja -C build install
fi

echo "[3/4] Preparing config directory and wallpaper folder..."
mkdir -p "$config_dir" "$wallpaper_dir"

if [[ ! -f "$repo_dir/Wallpaper.jpg" ]]; then
  echo "Please place your wallpaper as '$repo_dir/Wallpaper.jpg' and rerun this script."
  exit 1
fi

cp -f "$repo_dir/config/colors.json" "$config_dir/colors.json"
cp -f "$repo_dir/config/plugins.json" "$config_dir/plugins.json"

python3 - "$config_dir" "$wallpaper_dir" "$repo_dir/config/settings.json" <<'PY'
import json
import os
import sys

config_dir = sys.argv[1]
wallpaper_dir = sys.argv[2]
settings_path = sys.argv[3]

with open(settings_path, 'r', encoding='utf-8') as f:
    settings = json.load(f)

wallpaper_path = os.path.join(wallpaper_dir, 'Wallpaper.jpg')

# Replace personal paths with a portable user-local path.
settings['general']['avatarImage'] = wallpaper_path

# General portability: no user-specific monitor names or paths.
for key in ['monitors', 'screenOverrides']:
    if 'bar' in settings and key in settings['bar']:
        settings['bar'][key] = []
    if 'dock' in settings and key in settings['dock']:
        settings['dock'][key] = []
    if 'notifications' in settings and key in settings['notifications']:
        settings['notifications'][key] = []
    if 'osd' in settings and key in settings['osd']:
        settings['osd'][key] = []

# Remove monitor-specific widget layout to keep it portable.
if 'desktopWidgets' in settings:
    settings['desktopWidgets']['enabled'] = False
    settings['desktopWidgets']['monitorWidgets'] = []
    settings['desktopWidgets']['overviewEnabled'] = False

# Keep app launchers generic and safe on a fresh Arch setup.
settings['appLauncher']['pinnedApps'] = [
    'firefox',
    'org.gnome.Nautilus',
    'Alacritty',
    'org.gnome.Terminal'
]
settings['dock']['pinnedApps'] = [
    'firefox',
    'org.gnome.Nautilus',
    'org.gnome.Terminal',
    'Alacritty'
]

# Wallpaper setup: use the freshly copied wallpaper image.
settings['wallpaper']['directory'] = wallpaper_dir
settings['wallpaper']['favorites'] = [{
    "appearance": "dark",
    "colorScheme": "Catppuccin",
    "darkMode": True,
    "generationMethod": "tonal-spot",
    "paletteColors": ["#cba6f7", "#fab387", "#94e2d5", "#f38ba8"],
    "path": wallpaper_path,
    "useWallpaperColors": False,
}]
settings['wallpaper']['monitorDirectories'] = []
settings['wallpaper']['enabled'] = True
settings['wallpaper']['setWallpaperOnAllMonitors'] = True

# Keep the rest of the shell functional while avoiding hardcoded personal data.
settings['noctaliaPerformance'] = {
    'disableDesktopWidgets': True,
    'disableWallpaper': False,
}

with open(os.path.join(config_dir, 'settings.json'), 'w', encoding='utf-8') as f:
    json.dump(settings, f, indent=4)
    f.write('\n')
PY

cp -f "$repo_dir/Wallpaper.jpg" "$wallpaper_dir/Wallpaper.jpg"

echo "[4/4] Done. Noctalia is installed and configured with a portable setup. Wallpaper: $wallpaper_dir/Wallpaper.jpg"
